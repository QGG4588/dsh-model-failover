{
  "name": "dsh-model-failover",
  "version": "1.1.0",
  "description": "Model failover for DeepSeek Harness with a Web UI seat beside the composer model picker: pick one or more providers, pool = all models inside them; on request failure (RATE_LIMIT/QUOTA/TIMEOUT/...) auto-retry with the next untried model. Runtime tool model_failover (status/set/clear/enable/disable) plus an in-page panel.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg"
  ],
  "license": "MIT",
  "author": "QGG渗透大师 (QGG4588)",
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/QGG4588/dsh-model-failover.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model",
    "failover",
    "rotation",
    "retry",
    "provider-pool"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}





